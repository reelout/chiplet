{
  "name": "chiplet",
  "version": "0.6.0",
  "description": "React component, hook, and utility library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reelout/chiplet.git"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#.storybook/preview": "./.storybook/preview.tsx",
    "#.mock/*": "./test/.mock/*.ts",
    "#test": "./test/index.ts",
    "#component": "./src/component/index.ts",
    "#hook": "./src/hook/index.ts",
    "#infra": "./src/infra/index.ts",
    "#theme": "./src/theme/index.ts",
    "#util": "./src/util/index.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "storybook": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "development": "./src/*/index.ts",
      "storybook": "./src/*/index.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c && storybook build",
    "clean": "rimraf -g \"**/{dist,storybook-static,coverage,test-results,__screenshots__,.vitest,*.tsbuildinfo}\"",
    "dev": "storybook dev -p 6006",
    "format": "stylelint --fix \"**/*.{css,js,jsx,ts,tsx}\" && eslint --fix . && prettier --write .",
    "lint": "stylelint \"**/*.{css,js,jsx,ts,tsx}\" && eslint . && prettier --check .",
    "prepare": "husky",
    "pretest": "playwright install --with-deps",
    "test": "vitest",
    "validate": "pnpm i && pnpm clean && pnpm lint && pnpm build && pnpm test run --coverage"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@floating-ui/utils": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
